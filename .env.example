DATABASE_URL=sqlite:///./algo_sensei.db
PYTHON_BIN=python3
CODEX_CLI_PATH=codex
CODEX_MODEL=
CODEX_WORKDIR=.
CODEX_CLI_TIMEOUT_SECONDS=180
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=
CLAUDE_WORKDIR=.
CLAUDE_CLI_TIMEOUT_SECONDS=180
# Claude Code CLIの認証トークン。ホストで `claude setup-token` を実行し、表示されたトークンを貼り付けてください（macOSでは認証情報がKeychainにあり、~/.claudeのマウントだけではコンテナ内で認証できません）。
CLAUDE_CODE_OAUTH_TOKEN=
# 任意: Anthropic APIキーで認証する場合に設定します（CLAUDE_CODE_OAUTH_TOKENの代替）。
ANTHROPIC_API_KEY=
CODE_WORKSPACE_DIR=./workspace
CODE_WORKSPACE_PUBLIC_DIR=./workspace
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
